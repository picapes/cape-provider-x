{
  "schemaVersion": 1,
  "id": "${id}",
  "version": "${version}",
  "name": "${name}",
  "description": "${desc}",
  "authors": [
    "SyanicXD"
  ],
  "contributors": [
    {
      "name": "Cael & Capes mod contributors",
      "contact": {
        "homepage": "https://github.com/CaelTheColher/Capes"
      }
    },
      {
      "name": "litetex & cape provider mod contributors",
      "contact": {
        "homepage": "https://github.com/litetex-oss/mcm-cape-provider"
      }
    }
  ],
  "contact": {
    "homepage": "https://picapes.github.io/mod",
    "sources": "https://github.com/picapes/cape-provider-x",
    "issues": "https://github.com/picapes/cape-provider-x/issues"
  },
  "license": "${license_spdx_id}",
  "icon": "assets/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "net.litetex.capes.fabric.FabricCapes"
    ],
    "modmenu": [
      "net.litetex.capes.fabric.compat.ModMenuCompatibility"
    ]
  },
  "mixins": [
    "cape-provider.mixins.json"
  ],
  "accessWidener": "cape-provider.accesswidener",
  "requires": {
    "fabric-api": "*"
  },
  "recommends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": ">=${minecraft_version}",
    "fabric-api": ">=${fabric_api_version}",
    "modmenu": ">=${modmenu_version}"
  },
  "breaks": {
    "capes": "*"
  },
  "conflicts": {
    "minecraftcapes": "*",
    "capemod": "*",
    "cicada": "*",
    "voidcapes": "*",
    "bettercapes": "*",
    "cape-provider": "*"
  },
  "custom": {
    "cape": "Contributors",
    "modmenu": {
      "links": {
        "modmenu.github_releases": "https://github.com/picapes/cape-provider-x",
        "modmenu.modrinth": "https://modrinth.com/mod/${id}"
      }
    }
  }
}
